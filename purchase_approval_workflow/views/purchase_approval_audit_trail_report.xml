<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         QWeb PDF template — Approval Audit Trail
    ============================================================ -->
    <template id="report_purchase_approval_audit_trail_document">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <h2 class="text-center mb-3" style="color:#1F4E79;">
                        Purchase Order Approval Audit Trail
                    </h2>
                    <p class="text-center text-muted mb-4" style="font-size:11px;">
                        Generated: <t t-out="time.strftime('%Y-%m-%d %H:%M')"/> &#8226;
                        <t t-out="len(docs)"/> record(s)
                    </p>

                    <table class="table table-sm table-bordered" style="font-size:10px; width:100%;">
                        <thead>
                            <tr style="background-color:#1F4E79; color:white;">
                                <th style="width:12%;">PO Reference</th>
                                <th style="width:15%;">Vendor</th>
                                <th style="width:10%; text-align:right;">Amount</th>
                                <th style="width:5%; text-align:center;">Lvl</th>
                                <th style="width:15%;">Approver</th>
                                <th style="width:10%; text-align:center;">Decision</th>
                                <th style="width:13%;">Date</th>
                                <th style="width:20%;">Notes</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="docs" t-as="rec">
                                <tr t-attf-style="background-color: #{ '#d4edda' if rec.decision == 'approved' else '#f8d7da' }; vertical-align:top;">
                                    <td><t t-out="rec.purchase_order_name or ''"/></td>
                                    <td><t t-out="rec.partner_id.name or ''"/></td>
                                    <td style="text-align:right;">
                                        <t t-out="'{:,.2f}'.format(rec.amount_total)"/>
                                        <t t-if="rec.currency_id">&#160;<t t-out="rec.currency_id.symbol or rec.currency_id.name"/></t>
                                    </td>
                                    <td style="text-align:center;"><t t-out="rec.approval_level"/></td>
                                    <td><t t-out="rec.approver_id.name or ''"/></td>
                                    <td style="text-align:center; font-weight:bold;">
                                        <t t-if="rec.decision == 'approved'">
                                            <span style="color:#155724;">&#10003; Approved</span>
                                        </t>
                                        <t t-else="">
                                            <span style="color:#721c24;">&#10007; Rejected</span>
                                        </t>
                                    </td>
                                    <td><t t-out="rec.date.strftime('%Y-%m-%d %H:%M') if rec.date else ''"/></td>
                                    <td style="font-style:italic;"><t t-out="rec.notes or ''"/></td>
                                </tr>
                            </t>
                        </tbody>
                        <tfoot>
                            <tr style="background-color:#BDD7EE; font-weight:bold; font-size:10px;">
                                <td colspan="2">Total: <t t-out="len(docs)"/> record(s)</td>
                                <td style="text-align:right;">
                                    <t t-out="'{:,.2f}'.format(sum(r.amount_total for r in docs))"/>
                                </td>
                                <td colspan="5"></td>
                            </tr>
                        </tfoot>
                    </table>

                    <p class="mt-4 text-muted" style="font-size:9px; border-top:1px solid #ccc; padding-top:6px;">
                        This is an immutable audit trail generated by the Purchase Approval Workflow.
                        All approval decisions are permanent records and cannot be modified or deleted.
                    </p>
                </div>
            </t>
        </t>
    </template>

    <!-- ir.actions.report — binds to purchase.approval.history list + form -->
    <record id="action_report_purchase_approval_audit_trail" model="ir.actions.report">
        <field name="name">Approval Audit Trail</field>
        <field name="model">purchase.approval.history</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">purchase_approval_workflow.report_purchase_approval_audit_trail_document</field>
        <field name="binding_model_id" ref="purchase_approval_workflow.model_purchase_approval_history"/>
        <field name="binding_view_types">list,form</field>
        <field name="paperformat_id" ref="base.paperformat_euro"/>
    </record>

</odoo>
