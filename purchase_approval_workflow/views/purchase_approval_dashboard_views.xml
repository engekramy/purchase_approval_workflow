<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         My Pending Approvals — dedicated list view
         Shows only orders waiting for approval from the current user
    ============================================================ -->
    <record id="view_purchase_order_pending_approvals_list" model="ir.ui.view">
        <field name="name">purchase.order.pending.approvals.list</field>
        <field name="model">purchase.order</field>
        <field name="arch" type="xml">
            <list string="My Pending Approvals"
                  decoration-warning="is_overdue"
                  default_order="approval_deadline asc, date_order asc">

                <field name="name" string="Reference" readonly="1"/>
                <field name="partner_id" string="Vendor" readonly="1"/>
                <field name="user_id" string="Buyer" optional="show" readonly="1"/>
                <field name="date_order" string="Order Date" readonly="1"/>
                <field name="amount_total" string="Total" readonly="1"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="current_approval_level" string="Level" readonly="1"/>
                <field name="approval_deadline" string="Deadline" readonly="1"
                       decoration-danger="is_overdue"/>
                <field name="is_overdue" column_invisible="1"/>
                <field name="approval_state" column_invisible="1"/>
                <field name="can_approve" column_invisible="1"/>
                <field name="company_id" optional="show" groups="base.group_multi_company" readonly="1"/>

                <!-- Per-row inline Approve button -->
                <button name="action_approve"
                        string="Approve"
                        type="object"
                        icon="fa-check"
                        class="btn-success btn-sm"
                        invisible="not can_approve"
                        confirm="Approve this purchase order?"/>

                <!-- Per-row inline Reject button -->
                <button name="action_reject"
                        string="Reject"
                        type="object"
                        icon="fa-times"
                        class="btn-danger btn-sm"
                        invisible="not can_approve"/>

            </list>
        </field>
    </record>

    <!-- ============================================================
         Bulk Approve Server Action (available in Action menu)
    ============================================================ -->
    <record id="action_server_bulk_approve" model="ir.actions.server">
        <field name="name">Bulk Approve Selected</field>
        <field name="model_id" ref="purchase.model_purchase_order"/>
        <field name="binding_model_id" ref="purchase.model_purchase_order"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = records.action_bulk_approve()</field>
    </record>

    <!-- ============================================================
         My Pending Approvals — window action
         Domain is evaluated at runtime with uid so it only shows
         orders where the current user is the designated approver.
    ============================================================ -->
    <record id="action_my_pending_approvals" model="ir.actions.act_window">
        <field name="name">My Pending Approvals</field>
        <field name="res_model">purchase.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[
            ('approval_state', '=', 'waiting_approval'),
            ('current_approver_id', '=', uid),
        ]</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_purchase_order_pending_approvals_list')})]"/>
        <field name="context">{'default_approval_state': 'waiting_approval'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No pending approvals for you right now.
            </p>
            <p>
                Purchase orders submitted for your approval will appear here.
                You can approve or reject them individually or select multiple
                orders and use <strong>Action → Bulk Approve Selected</strong>.
            </p>
        </field>
    </record>

    <!-- ============================================================
         All Pending Approvals — for managers (all waiting orders)
    ============================================================ -->
    <record id="action_all_pending_approvals" model="ir.actions.act_window">
        <field name="name">All Pending Approvals</field>
        <field name="res_model">purchase.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('approval_state', '=', 'waiting_approval')]</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_purchase_order_pending_approvals_list')})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No purchase orders waiting for approval.
            </p>
        </field>
    </record>

</odoo>
