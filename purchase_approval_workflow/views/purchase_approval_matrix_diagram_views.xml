<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         Approval Workflow Diagram – wizard form
    ============================================================ -->
    <record id="view_purchase_approval_matrix_diagram_form" model="ir.ui.view">
        <field name="name">purchase.approval.matrix.diagram.form</field>
        <field name="model">purchase.approval.matrix.diagram</field>
        <field name="arch" type="xml">
            <form string="Approval Workflow Diagram">
                <sheet>
                    <div class="oe_title">
                        <h2>Approval Workflow Diagram</h2>
                    </div>

                    <group col="4">
                        <field name="company_id"
                               colspan="2"
                               groups="base.group_multi_company"/>
                        <field name="rule_count"
                               string="Active Rules"
                               readonly="1"/>
                        <field name="level_count"
                               string="Approval Levels"
                               readonly="1"/>
                    </group>

                    <separator/>

                    <field name="diagram_html"
                           widget="html"
                           readonly="1"
                           nolabel="1"/>
                </sheet>
                <footer>
                    <button name="action_new_rule"
                            string="+ New Rule"
                            type="object"
                            class="btn-primary"/>
                    <button name="action_open_matrix"
                            string="Open Full Matrix"
                            type="object"
                            class="btn-secondary"/>
                    <button string="Close"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- ============================================================
         Window action – opens as a large dialog
    ============================================================ -->
    <record id="action_purchase_approval_matrix_diagram" model="ir.actions.act_window">
        <field name="name">Workflow Diagram</field>
        <field name="res_model">purchase.approval.matrix.diagram</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'dialog_size': 'extra-large'}</field>
    </record>

</odoo>
